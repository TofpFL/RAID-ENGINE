<?xml version="1.0" encoding="utf-8"?>
<!-- God's Hand for Android: a NativeActivity running libgodshand.so.
     versionCode/versionName are set by build_apk.sh from CMakeLists.txt. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.godshand.game">

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Mod packs are downloaded from the game's GitHub releases. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:allowBackup="false"
        android:isGame="true"
        android:appCategory="game"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
        <activity
            android:name=".GameActivity"
            android:label="@string/app_name"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:exported="true">
            <meta-data android:name="android.app.lib_name" android:value="godshand" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
